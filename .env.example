# Mistral AI API Credentials
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_EMBEDDING_MODEL=mistral-embed

# Windows 11 Local Storage Paths
LOTTI_SYSTEM_PROMPT_PATH=C:\integriti\prompts\system_prompt.md
LOTTI_LANCEDB_PATH=C:\integriti\lancedb_data
LOTTI_LANCEDB_TABLE=internal_knowledge

# RAG Retrieval Settings
LOTTI_RAG_TOP_K=3
LOTTI_RAG_SCORE_THRESHOLD=1.95
LOTTI_SEED_SAMPLE_DATA=true

# Audio DSP Configuration (Mistral DefaultAudioInterface)
LOTTI_ECHO_CANCELLATION=true
LOTTI_NOISE_SUPPRESSION=true
LOTTI_HIGH_PASS_FILTER=true
LOTTI_AUTO_GAIN_CONTROL=true
LOTTI_OUTPUT_BUFFER_MS=300

# System Prompt Hot-Reloading
LOTTI_PROMPT_HOT_RELOAD=true
LOTTI_PROMPT_POLL_SEC=5.0
LOTTI_LOG_LEVEL=INFO
